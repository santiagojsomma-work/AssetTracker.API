@page
@model AssetTracker.Web.Pages.Activos.BusquedaModel
@{
    ViewData["Title"] = "Búsqueda en vivo";
}

<div class="page-header">
    <h1><i class="bi bi-search"></i> Búsqueda en vivo</h1>
    <p class="lead">Buscador global: nombre, código interno, número de serie o clave de licencia, sin recargar la página</p>
</div>

<div class="card">
    <div class="card-body">
        <input type="text" id="txtBuscar" class="form-control form-control-lg"
               placeholder="Escribí al menos 2 caracteres… (ej: ACT-0002, Samsung, XXXXX-)" />
        <div class="d-flex justify-content-between mt-2">
            <small class="text-muted-custom">La búsqueda se ejecuta automáticamente mientras escribís (debounce 300 ms).</small>
            @* 16B: diferenciación de buscadores *@
            <small class="text-muted-custom">
                ¿Necesitás combinar texto con estado y orden? <a asp-page="Index">Usá el listado con filtros</a>.
            </small>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header"><i class="bi bi-list-ul"></i> Resultados</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Estado</th>
                        <th class="text-end">Valor</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tbodyResultados"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 11B: el comportamiento vive en site.js; la URL es de MISMO origen (proxy Razor)
        inicializarBusquedaEnVivo(
            'txtBuscar',
            'tbodyResultados',
            '/Activos/Busqueda?handler=Buscar&texto={texto}',
            (a) => `
                <tr>
                    <td><code>${a.codigoInterno ?? '—'}</code></td>
                    <td class="fw-bold">${a.nombre}</td>
                    <td>${a.estado}</td>
                    <td class="text-end">$${a.valorOriginal.toLocaleString('es-AR')}</td>
                    <td class="text-center">
                        <a href="/Activos/Details/${a.id}" class="btn btn-outline-info btn-sm">
                            <i class="bi bi-eye"></i>
                        </a>
                    </td>
                </tr>`);
    </script>
}
