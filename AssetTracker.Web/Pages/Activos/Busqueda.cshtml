@page
@model AssetTracker.Web.Pages.Activos.BusquedaModel
@{
    ViewData["Title"] = "Búsqueda en vivo";
}

<div class="page-header">
    <h1><i class="bi bi-search"></i> Búsqueda en vivo</h1>
    <p class="lead">Buscador global: nombre, código interno, número de serie o clave de licencia, sin recargar la página</p>
</div>

<div class="card">
    <div class="card-body">
        <input type="text" id="txtBuscar" class="form-control form-control-lg"
               placeholder="Escribí al menos 2 caracteres… (ej: ACT-0002, Samsung, XXXXX-)" />
        <div class="d-flex justify-content-between flex-wrap gap-2 mt-2">
            <small class="text-muted-custom">
                <i class="bi bi-lightning-charge"></i>
                La búsqueda se ejecuta automáticamente mientras escribís (debounce 300 ms).
            </small>
            <small class="text-muted-custom">
                ¿Necesitás combinar texto con estado y orden?
                <a asp-page="Index">Usá el listado con filtros</a>.
            </small>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header"><i class="bi bi-list-ul"></i> Resultados</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Estado</th>
                        <th class="text-end">Valor</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tbodyResultados"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 11B: el comportamiento (debounce + fetch) vive en wwwroot/js/site.js.
        // La URL es de MISMO origen: el handler OnGetBuscarAsync hace de proxy
        // hacia la API (evita CORS y oculta la URL del backend al navegador).
        inicializarBusquedaEnVivo(
            'txtBuscar',
            'tbodyResultados',
            '/Activos/Busqueda?handler=Buscar&texto={texto}',
            (a) => `
                <tr>
                    <td><code class="fw-bold">${a.codigoInterno ?? '—'}</code></td>
                    <td class="celda-wrap">
                        <div class="fw-bold">${a.nombre}</div>
                        <small class="text-muted-custom">${a.discriminator === 'ActivoFisico' ? 'Físico' : 'Digital'}</small>
                    </td>
                    <td>${a.estado}</td>
                    <td class="celda-monto">$${a.valorOriginal.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                    <td class="text-center">
                        <a href="/Activos/Details/${a.id}" class="btn btn-outline-info btn-sm" title="Ver detalles">
                            <i class="bi bi-eye"></i>
                        </a>
                    </td>
                </tr>`);
    </script>
}
