@page "{id:int}"
@using AssetTracker.Web.Helpers
@model AssetTracker.Web.Pages.Activos.DetailsModel
@{
    ViewData["Title"] = "Detalle de activo";
}

@if (Model.Activo == null)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle"></i> No se encontró el activo.
    </div>
    <a asp-page="Index" class="btn btn-secondary">Volver al listado</a>
}
else
{
    <div class="page-header">
        <h1><i class="bi bi-box-seam"></i> @Model.Activo.Nombre</h1>
        <p class="lead mb-0">
            <code class="text-white">@Model.Activo.CodigoInterno</code>
            <span class="badge-estado @EstadoActivoHelper.Badge(Model.Activo.Estado) ms-2">
                <i class="bi @EstadoActivoHelper.Icono(Model.Activo.Estado)"></i> @Model.Activo.Estado
            </span>
        </p>
    </div>

    @if (Model.Error is not null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle"></i> @Model.Error
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header"><i class="bi bi-info-circle"></i> Información general</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Código interno</dt>
                        <dd class="col-sm-8"><code>@Model.Activo.CodigoInterno</code></dd>

                        <dt class="col-sm-4">Tipo</dt>
                        <dd class="col-sm-8">
                            <i class="bi @(Model.Activo.TipoActivo == "Físico" ? "bi-box" : "bi-laptop") text-primary"></i>
                            @Model.Activo.TipoActivo
                        </dd>

                        <dt class="col-sm-4">Fecha de adquisición</dt>
                        <dd class="col-sm-8">@Model.Activo.FechaAdquisicion.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4">Valor original</dt>
                        <dd class="col-sm-8 fw-bold">@Model.Activo.ValorOriginal.ToString("C")</dd>

                        @if (Model.Activo.TipoActivo == "Físico")
                        {
                            <dt class="col-sm-4">Número de serie</dt>
                            <dd class="col-sm-8">@Model.Activo.NumeroSerie</dd>

                            <dt class="col-sm-4">Ubicación</dt>
                            <dd class="col-sm-8">@Model.Activo.Ubicacion</dd>
                        }
                        else
                        {
                            <dt class="col-sm-4">Clave de licencia</dt>
                            <dd class="col-sm-8">@Model.Activo.ClaveLicencia</dd>

                            <dt class="col-sm-4">Vencimiento</dt>
                            <dd class="col-sm-8">@Model.Activo.FechaVencimientoLicencia?.ToString("dd/MM/yyyy")</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card">
                <div class="card-header"><i class="bi bi-arrow-repeat"></i> Cambiar estado</div>
                <div class="card-body">
                    <p class="text-muted-custom small">
                        Los estados <strong>Disponible</strong> y <strong>Asignado</strong> se gestionan
                        automáticamente desde el módulo de Asignaciones.
                    </p>
                    <form method="post" asp-page-handler="CambiarEstado" asp-route-id="@Model.Activo.Id">
                        <div class="mb-3">
                            <label class="form-label">Nuevo estado</label>
                            <select name="NuevoEstado" class="form-select" required>
                                <option value="">-- Seleccioná un estado --</option>
                                @foreach (var estado in EstadoActivoHelper.Todos)
                                {
                                    if (estado != "Disponible" && estado != "Asignado")
                                    {
                                        <option value="@estado">@estado</option>
                                    }
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-check2-circle"></i> Aplicar cambio
                        </button>
                    </form>
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <a asp-page="Edit" asp-route-id="@Model.Activo.Id" class="btn btn-outline-primary flex-fill">
                    <i class="bi bi-pencil"></i> Editar
                </a>
                <a asp-page="Index" class="btn btn-outline-secondary flex-fill">
                    <i class="bi bi-arrow-left"></i> Volver
                </a>
            </div>
        </div>
    </div>
}