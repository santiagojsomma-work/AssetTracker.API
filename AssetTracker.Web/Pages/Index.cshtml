@page
@model AssetTracker.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <h1><i class="bi bi-speedometer2"></i> Dashboard</h1>
    <p class="lead">Bienvenido a AssetTracker — Sistema de Gestión de Activos Empresariales</p>
</div>

@if (Model.Error is not null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle"></i> @Model.Error
    </div>
}

@* ===== Tarjetas de estadísticas ===== *@
<div class="row g-4 mb-4">
    <div class="col-lg-3 col-md-6">
        <div class="card text-white bg-primary h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase mb-2">Total activos</h6>
                    <div class="stat-valor">@Model.Estadisticas.TotalActivos</div>
                </div>
                <i class="bi bi-box-seam fs-1 opacity-50"></i>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card text-white bg-success h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase mb-2">Valor total</h6>
                    @* V2: monto completo en una sola línea, sin cortar el $ *@
                    <div class="stat-valor">@Model.Estadisticas.ValorTotal.ToString("C")</div>
                </div>
                <i class="bi bi-currency-dollar fs-1 opacity-50"></i>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card text-white bg-warning h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase mb-2">Disponibles</h6>
                    <div class="stat-valor">@Model.Estadisticas.ActivosDisponibles</div>
                </div>
                <i class="bi bi-check2-circle fs-1 opacity-50"></i>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card text-white bg-danger h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase mb-2">Asignados</h6>
                    <div class="stat-valor">@Model.Estadisticas.ActivosAsignados</div>
                </div>
                <i class="bi bi-people fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
</div>

@* ===== Accesos rápidos a los módulos ===== *@
<div class="row g-4">
    <div class="col-lg-3 col-md-6">
        <div class="card h-100 text-center">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <i class="bi bi-box-seam text-primary" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">Gestión de Activos</h5>
                    <p class="text-muted-custom">
                        Administrá activos físicos y digitales, con seguimiento de estados y valor.
                    </p>
                </div>
                <a asp-page="/Activos/Index" class="btn btn-primary">
                    <i class="bi bi-arrow-right"></i> Ver Activos
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card h-100 text-center">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <i class="bi bi-people text-success" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">Gestión de Empleados</h5>
                    <p class="text-muted-custom">
                        Administrá los empleados y sus departamentos de la organización.
                    </p>
                </div>
                <a asp-page="/Empleados/Index" class="btn btn-success">
                    <i class="bi bi-arrow-right"></i> Ver Empleados
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card h-100 text-center">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <i class="bi bi-arrow-left-right text-warning" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">Asignaciones</h5>
                    <p class="text-muted-custom">
                        Controlá qué activos están asignados a qué empleados.
                    </p>
                </div>
                <a asp-page="/Asignaciones/Index" class="btn btn-warning">
                    <i class="bi bi-arrow-right"></i> Ver Asignaciones
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card h-100 text-center">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <i class="bi bi-tools text-danger" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">Mantenimientos</h5>
                    <p class="text-muted-custom">
                        Programá y seguí mantenimientos preventivos y correctivos.
                    </p>
                </div>
                <a asp-page="/Mantenimientos/Index" class="btn btn-danger">
                    <i class="bi bi-arrow-right"></i> Ver Mantenimientos
                </a>
            </div>
        </div>
    </div>
</div>