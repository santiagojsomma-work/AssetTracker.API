@page
@model AssetTracker.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-speedometer2"></i> Dashboard</h1>
        <p class="lead">Bienvenido a AssetTracker — Sistema de Gestión de Activos Empresariales</p>
    </div>
</div>

@if (Model.Error is not null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle"></i> @Model.Error
    </div>
}
else
{
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="card stat-card bg-primary">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-label">Total Activos</div>
                        <div class="stat-value">@Model.Estadisticas.TotalActivos</div>
                    </div>
                    <div class="stat-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card stat-card bg-success">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-label">Valor Total</div>
                        <div class="stat-value">@Model.Estadisticas.ValorTotal.ToString("C")</div>
                    </div>
                    <div class="stat-icon">
                        <i class="bi bi-currency-dollar"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card stat-card bg-warning">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-label">Disponibles</div>
                        <div class="stat-value">@Model.Estadisticas.ActivosDisponibles</div>
                    </div>
                    <div class="stat-icon">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card stat-card bg-danger">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-label">Asignados</div>
                        <div class="stat-value">@Model.Estadisticas.ActivosAsignados</div>
                    </div>
                    <div class="stat-icon">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-hover h-100">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="bi bi-box-seam text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title">Gestión de Activos</h5>
                    <p class="card-text text-muted-custom">
                        Administra activos físicos y digitales, con seguimiento de estados y valor.
                    </p>
                    <a asp-page="/Activos/Index" class="btn btn-primary">
                        <i class="bi bi-arrow-right"></i> Ver Activos
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-hover h-100">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="bi bi-people text-success" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title">Gestión de Empleados</h5>
                    <p class="card-text text-muted-custom">
                        Administra los empleados y sus departamentos de la organización.
                    </p>
                    <a asp-page="/Empleados/Index" class="btn btn-success">
                        <i class="bi bi-arrow-right"></i> Ver Empleados
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-hover h-100">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="bi bi-arrow-left-right text-warning" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title">Asignaciones</h5>
                    <p class="card-text text-muted-custom">
                        Controla qué activos están asignados a qué empleados.
                    </p>
                    <a asp-page="/Asignaciones/Index" class="btn btn-warning">
                        <i class="bi bi-arrow-right"></i> Ver Asignaciones
                    </a>
                </div>
            </div>
        </div>
    </div>
}
