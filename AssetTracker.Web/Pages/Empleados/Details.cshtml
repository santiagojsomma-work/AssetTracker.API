@page "{id:int}"
@model AssetTracker.Web.Pages.Empleados.DetailsModel
@{
    ViewData["Title"] = "Ficha del empleado";
}

@if (Model.Error is not null)
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> @Model.Error</div>
    <a asp-page="Index" class="btn btn-secondary">Volver</a>
}
else if (Model.Empleado == null)
{
    <div class="alert alert-warning">No se encontró el empleado.</div>
    <a asp-page="Index" class="btn btn-secondary">Volver</a>
}
else
{
    var e = Model.Empleado;
    <div class="page-header">
        <h1>
            <i class="bi bi-person"></i> @e.NombreCompleto
            @if (e.Activo)
            {
                <span class="badge-estado estado-disponible ms-2"><i class="bi bi-check-circle-fill"></i> Activo</span>
            }
            else
            {
                <span class="badge-estado estado-baja ms-2"><i class="bi bi-slash-circle-fill"></i> Inactivo</span>
            }
        </h1>
        <p class="lead mb-0">@e.Cargo — @e.Departamento</p>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card">
                <div class="card-header"><i class="bi bi-info-circle"></i> Información</div>
                <div class="card-body">
                    <dl class="row mb-0 dl-detalle">
                        <dt class="col-sm-5">Documento</dt>
                        <dd class="col-sm-7"><code>@(e.Documento ?? "—")</code></dd>

                        <dt class="col-sm-5">Correo</dt>
                        <dd class="col-sm-7">
                            @if (!string.IsNullOrWhiteSpace(e.Correo))
                            {
                                <a href="mailto:@e.Correo">@e.Correo</a>
                            }
                            else
                            {

                                <span class="text-muted-custom">—</span>
                            }
                        </dd>

                        <dt class="col-sm-5">Teléfono</dt>
                        <dd class="col-sm-7">@(e.Telefono ?? "—")</dd>

                        <dt class="col-sm-5">Cargo</dt>
                        <dd class="col-sm-7">@(e.Cargo ?? "—")</dd>

                        <dt class="col-sm-5">Departamento</dt>
                        <dd class="col-sm-7">@e.Departamento</dd>

                        <dt class="col-sm-5">Fecha de ingreso</dt>
                        <dd class="col-sm-7">@(e.FechaIngreso?.ToString("dd/MM/yyyy") ?? "—")</dd>

                        <dt class="col-sm-5">Asignaciones</dt>
                        <dd class="col-sm-7"><strong>@e.TotalAsignaciones</strong></dd>
                    </dl>
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <a asp-page="Edit" asp-route-id="@e.Id" class="btn btn-primary flex-fill">
                    <i class="bi bi-pencil"></i> Editar
                </a>
                <a asp-page="Index" class="btn btn-outline-secondary flex-fill">
                    <i class="bi bi-arrow-left"></i> Volver
                </a>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card">
                <div class="card-header"><i class="bi bi-box-seam"></i> Activos asignados</div>
                <div class="card-body p-0">
                    @if (e.Asignaciones.Count == 0)
                    {
                        <div class="text-center p-4">
                            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted-custom mt-2">Este empleado no tiene activos asignados</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Activo</th>
                                        <th>Estado</th>
                                        <th class="text-end">Valor</th>
                                        <th>Fecha</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in e.Asignaciones)
                                    {
                                        <tr>
                                            <td class="fw-bold">@a.ActivoNombre</td>
                                            <td><span class="badge @(a.ActivoEstado == "Asignado" ? "bg-warning" : "bg-secondary")">@a.ActivoEstado</span></td>
                                            <td class="celda-monto">@a.ActivoValor.ToString("C")</td>
                                            <td>@a.FechaAsignacion.ToString("dd/MM/yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
