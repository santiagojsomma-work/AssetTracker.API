@page "{id:int}"
@model AssetTracker.Web.Pages.Empleados.DetailsModel
@{
    ViewData["Title"] = "Detalle de empleado";
}

@if (Model.Error is not null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle"></i> @Model.Error
    </div>
    <a asp-page="Index" class="btn btn-secondary">Volver al listado</a>
}
else if (Model.Empleado == null)
{
    <div class="alert alert-warning">No se encontró el empleado.</div>
    <a asp-page="Index" class="btn btn-secondary">Volver al listado</a>
}
else
{
    <div class="page-header">
        <h1><i class="bi bi-person"></i> @Model.Empleado.NombreCompleto</h1>
        <p class="lead">@Model.Empleado.Departamento</p>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header"><i class="bi bi-info-circle"></i> Información</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">ID</dt>
                        <dd class="col-sm-8">#@Model.Empleado.Id</dd>

                        <dt class="col-sm-4">Nombre</dt>
                        <dd class="col-sm-8">@Model.Empleado.NombreCompleto</dd>

                        <dt class="col-sm-4">Departamento</dt>
                        <dd class="col-sm-8">@Model.Empleado.Departamento</dd>

                        <dt class="col-sm-4">Asignaciones</dt>
                        <dd class="col-sm-8"><strong>@Model.Empleado.TotalAsignaciones</strong></dd>
                    </dl>
                </div>
            </div>

            <div class="mt-3">
                <a asp-page="Edit" asp-route-id="@Model.Empleado.Id" class="btn btn-primary w-100">
                    <i class="bi bi-pencil"></i> Editar
                </a>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-box-seam"></i> Activos asignados
                </div>
                <div class="card-body p-0">
                    @if (Model.Empleado.Asignaciones.Count == 0)
                    {
                        <div class="text-center p-4">
                            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted-custom mt-2">Este empleado no tiene activos asignados</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Activo</th>
                                        <th>Estado</th>
                                        <th class="text-end">Valor</th>
                                        <th>Fecha asignación</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in Model.Empleado.Asignaciones)
                                    {
                                        <tr>
                                            <td><strong>@a.ActivoNombre</strong></td>
                                            <td>
                                                <span class="badge @(a.ActivoEstado == "Asignado" ? "bg-warning" : "bg-secondary")">
                                                    @a.ActivoEstado
                                                </span>
                                            </td>
                                            <td class="text-end">@a.ActivoValor.ToString("C")</td>
                                            <td>@a.FechaAsignacion.ToString("dd/MM/yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver al listado
        </a>
    </div>
}