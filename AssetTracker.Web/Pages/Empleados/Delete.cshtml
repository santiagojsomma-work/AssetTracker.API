@page "{id:int}"
@model AssetTracker.Web.Pages.Empleados.DeleteModel
@{
    ViewData["Title"] = "Eliminar empleado";
}

<h1>Eliminar empleado</h1>

@if (Model.Error is not null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle"></i> @Model.Error
    </div>
}

@if (Model.Empleado == null)
{
    <div class="alert alert-warning">No se encontró el empleado.</div>
    <a asp-page="Index" class="btn btn-secondary">Volver</a>
}
else
{
    @if (Model.Empleado.TieneAsignaciones)
    {
        <div class="alert alert-warning">
            <h5><i class="bi bi-exclamation-triangle"></i> Atención</h5>
            <p class="mb-0">
                Este empleado tiene <strong>asignaciones activas</strong> que se eliminarán en cascada.
                Los activos asignados volverán a estar <strong>Disponibles</strong> automáticamente.
            </p>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Este empleado no tiene asignaciones activas.
        </div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">@Model.Empleado.Id</dd>

                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9">@Model.Empleado.NombreCompleto</dd>

                <dt class="col-sm-3">Departamento</dt>
                <dd class="col-sm-9">@Model.Empleado.Departamento</dd>
            </dl>
        </div>
    </div>

    <form method="post">
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash"></i> Eliminar
        </button>
        <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
    </form>
}