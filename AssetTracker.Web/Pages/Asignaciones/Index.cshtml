@page
@model AssetTracker.Web.Pages.Asignaciones.IndexModel
@{
    ViewData["Title"] = "Asignaciones";
}

<div class="page-header">
    <h1><i class="bi bi-arrow-left-right"></i> Asignaciones</h1>
    <p class="lead">Control de activos asignados a empleados</p>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-list-ul"></i> Listado de asignaciones</h5>
        <a asp-page="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle"></i> Nueva asignación
        </a>
    </div>

    <div class="card-body p-0">
        @if (Model.Error is not null)
        {
            <div class="alert alert-danger m-3">
                <i class="bi bi-exclamation-triangle"></i> @Model.Error
            </div>
        }
        else if (Model.Asignaciones.Count == 0)
        {
            <div class="text-center p-5">
                <i class="bi bi-inbox text-muted" style="font-size: 4rem;"></i>
                <h4 class="mt-3 text-muted-custom">No hay asignaciones registradas</h4>
                <a asp-page="Create" class="btn btn-primary mt-2">
                    <i class="bi bi-plus-circle"></i> Crear asignación
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Activo</th>
                            <th>Empleado</th>
                            <th>Fecha</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Asignaciones)
                        {
                            <tr>
                                <td><strong>#@item.Id</strong></td>
                                <td>
                                    @* 12B: link al detalle del activo *@
                                    <a asp-page="/Activos/Details" asp-route-id="@item.ActivoId"
                                       class="text-decoration-none fw-bold">
                                        <i class="bi bi-box-seam text-primary"></i>
                                        @(item.Activo?.Nombre ?? $"Activo {item.ActivoId}")
                                    </a>
                                </td>
                                <td>
                                    @* 12B: link a la ficha del empleado *@
                                    <a asp-page="/Empleados/Details" asp-route-id="@item.EmpleadoId"
                                       class="text-decoration-none">
                                        <i class="bi bi-person text-success"></i>
                                        @(item.Empleado?.NombreCompleto ?? $"Empleado {item.EmpleadoId}")
                                    </a>
                                </td>
                                <td>@item.FechaAsignacion.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <a asp-page="Delete" asp-route-id="@item.Id"
                                       class="btn btn-outline-danger btn-sm" title="Eliminar asignación">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>