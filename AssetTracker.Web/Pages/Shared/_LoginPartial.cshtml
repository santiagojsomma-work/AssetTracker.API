@using Microsoft.AspNetCore.Identity
@using AssetTracker.Web.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var usuario = await UserManager.GetUserAsync(User);
    var roles = usuario == null
        ? new List<string>()
        : (await UserManager.GetRolesAsync(usuario)).ToList();
    var rol = roles.Count > 0 ? roles[0] : "Sin rol";

    <ul class="navbar-nav align-items-center gap-2">
        <li class="nav-item">
            <span class="navbar-text">
                <i class="bi bi-person-circle"></i>
                <strong>@usuario?.UserName</strong>
                <span class="badge bg-light text-dark border ms-1" title="Rol del usuario">@rol</span>
            </span>
        </li>
        <li class="nav-item">
            <form class="m-0" method="post" asp-page="/Account/Logout">
                <button type="submit" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-box-arrow-right"></i> Salir
                </button>
            </form>
        </li>
    </ul>
}
else
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="btn btn-outline-light btn-sm" asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión
            </a>
        </li>
    </ul>
}
