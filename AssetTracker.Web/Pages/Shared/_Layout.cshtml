<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AssetTracker</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Estilos personalizados -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
            <div class="container-fluid">
                <a class="navbar-brand" asp-page="/Index">AssetTracker</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Activos/Index">
                                <i class="bi bi-box-seam"></i> Activos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Empleados/Index">
                                <i class="bi bi-people"></i> Empleados
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Asignaciones/Index">
                                <i class="bi bi-arrow-left-right"></i> Asignaciones
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Activos/Busqueda">
                                <i class="bi bi-search"></i> Búsqueda
                            </a>
                        </li>
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-muted-custom">
                    <small>&copy; 2026 <strong>AssetTracker</strong> — TP Integrador Programación .NET</small>
                </div>
                <div class="col-md-6 text-md-end text-muted-custom">
                    <small>
                        <i class="bi bi-code-slash"></i> Desarrollado con
                        <i class="bi bi-heart-fill text-danger"></i> en .NET 10
                    </small>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>