@page
@model AssetTracker.Web.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="text-center p-5">
    <i class="bi bi-shield-lock text-danger" style="font-size: 4rem;"></i>
    <h2 class="mt-3">Acceso denegado</h2>
    <p class="text-muted-custom">
        Tu usuario no tiene permisos para realizar esta acción.
        Si creés que es un error, consultá con el administrador del sistema.
    </p>
    <a asp-page="/Index" class="btn btn-primary">
        <i class="bi bi-house"></i> Volver al inicio
    </a>
</div>