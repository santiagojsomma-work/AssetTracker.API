@page
@model AssetTracker.Web.Pages.Mantenimientos.IndexModel
@{
    ViewData["Title"] = "Mantenimientos";
}

<div class="page-header">
    <h1><i class="bi bi-tools"></i> Mantenimientos</h1>
    <p class="lead">Gestión de mantenimientos preventivos y correctivos de activos</p>
</div>

<form method="get" class="filtros-bar">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label mb-1">Estado</label>
            <select name="FiltroEstado" class="form-select">
                <option value="">Todos</option>
                <option value="Pendiente" selected="@(Model.FiltroEstado == "Pendiente")">Pendiente</option>
                <option value="En Progreso" selected="@(Model.FiltroEstado == "En Progreso")">En Progreso</option>
                <option value="Vencido" selected="@(Model.FiltroEstado == "Vencido")">Vencido</option>
                <option value="Completado" selected="@(Model.FiltroEstado == "Completado")">Completado</option>
                <option value="Cancelado" selected="@(Model.FiltroEstado == "Cancelado")">Cancelado</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label mb-1">Tipo</label>
            <select name="FiltroTipo" class="form-select">
                <option value="">Todos</option>
                <option value="Preventivo" selected="@(Model.FiltroTipo == "Preventivo")">Preventivo</option>
                <option value="Correctivo" selected="@(Model.FiltroTipo == "Correctivo")">Correctivo</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">
                <i class="bi bi-funnel"></i> Filtrar
            </button>
            <a asp-page="Index" class="btn btn-outline-secondary" title="Limpiar filtros">
                <i class="bi bi-x-circle"></i>
            </a>
        </div>
        <div class="col-md-4 text-end">
            <a asp-page="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Nuevo Mantenimiento
            </a>
        </div>
    </div>
</form>

<div class="card">
    <div class="stats-bar">
        <span class="stat-item">Total: <strong>@Model.Total</strong></span>
        <span class="stat-item stat-azul">Pendientes/En Progreso: <strong>@Model.Pendientes</strong></span>
        <span class="stat-item stat-rojo">Vencidos: <strong>@Model.Vencidos</strong></span>
        <span class="stat-item stat-verde">Completados: <strong>@Model.Completados</strong></span>
        <span class="stat-item ms-auto">Costo total: <strong>@Model.CostoTotal.ToString("C")</strong></span>
    </div>

    <div class="card-body p-0">
        @if (Model.Error is not null)
        {
            <div class="alert alert-danger m-3"><i class="bi bi-exclamation-triangle"></i> @Model.Error</div>
        }
        else if (Model.Mantenimientos.Count == 0)
        {
            <div class="text-center p-5">
                <i class="bi bi-inbox text-muted" style="font-size: 4rem;"></i>
                <h4 class="mt-3 text-muted-custom">No se encontraron mantenimientos</h4>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Activo</th>
                            <th>Tipo</th>
                            <th>Fecha Programada</th>
                            <th class="text-end">Costo</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Mantenimientos)
                        {
                            // Clases de fila del Lote V1
                            string filaClass = item.EstadoReal switch
                            {
                                "Vencido" => "fila-vencida",
                                "Completado" => "fila-completada",
                                "En Progreso" => "fila-mantenimiento",
                                _ => ""
                            };

                            <tr class="@filaClass">
                                <td><code class="fw-bold">@item.CodigoInterno</code></td>
                                <td class="celda-wrap fw-bold">@item.NombreActivo</td>
                                <td>
                                    <span class="badge @(item.Tipo == "Preventivo" ? "bg-info" : "bg-warning")">@item.Tipo</span>
                                </td>
                                <td>@item.FechaProgramada.ToString("dd/MM/yyyy")</td>
                                <td class="celda-monto">@item.Costo.ToString("C")</td>
                                <td>
                                    <span class="badge-estado @(item.EstadoReal switch
                                          {
                                              "Pendiente" => "estado-asignado",
                                              "En Progreso" => "estado-mantenimiento",
                                              "Vencido" => "estado-robado",
                                              "Completado" => "estado-disponible",
                                              "Cancelado" => "estado-baja",
                                              _ => "estado-otro"
                                          })">
                                        @item.EstadoReal
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        @if (item.EstadoReal is "Pendiente" or "En Progreso" or "Vencido")
                                        {
                                            <form method="post" asp-page-handler="Completar" asp-route-id="@item.Id" class="d-inline">
                                                <button type="submit" class="btn btn-outline-success btn-sm" title="Completar">
                                                    <i class="bi bi-check-circle"></i>
                                                </button>
                                            </form>
                                            <form method="post" asp-page-handler="Cancelar" asp-route-id="@item.Id" class="d-inline">
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Cancelar">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                        }
                                        <form method="post" asp-page-handler="Eliminar" asp-route-id="@item.Id" class="d-inline" onsubmit="return confirm('¿Estás seguro de eliminar este registro?');">
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
