@page
@model AssetTracker.Web.Pages.Mantenimientos.CreateModel
@{
    ViewData["Title"] = "Nuevo Mantenimiento";
}

<div class="page-header">
    <h1><i class="bi bi-plus-circle"></i> Nuevo Mantenimiento</h1>
    <p class="lead">Registrar un mantenimiento preventivo o correctivo para un activo</p>
</div>

@if (Model.Error is not null)
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> @Model.Error</div>
}

<div class="card">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.ActivoId" class="form-label">Activo</label>
                    <select asp-for="Input.ActivoId" class="form-select">
                        <option value="">-- Seleccioná un activo --</option>
                        @foreach (var item in Model.Activos)
                        {
                            <option value="@item.Id">@item.CodigoInterno — @item.Nombre</option>
                        }
                    </select>
                    <span asp-validation-for="Input.ActivoId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Tipo" class="form-label">Tipo</label>
                    <select asp-for="Input.Tipo" class="form-select">
                        <option value="Preventivo">Preventivo</option>
                        <option value="Correctivo">Correctivo</option>
                    </select>
                    <span asp-validation-for="Input.Tipo" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.Descripcion" class="form-label">Descripción del trabajo</label>
                    <textarea asp-for="Input.Descripcion" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Input.Descripcion" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Proveedor" class="form-label">Proveedor (opcional)</label>
                    <input asp-for="Input.Proveedor" class="form-control" />
                    <span asp-validation-for="Input.Proveedor" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.FechaProgramada" class="form-label">Fecha Programada</label>
                    <input asp-for="Input.FechaProgramada" type="date" class="form-control" />
                    <span asp-validation-for="Input.FechaProgramada" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Costo" class="form-label">Costo Estimado</label>
                    <input asp-for="Input.Costo" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Input.Costo" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check2-circle"></i> Guardar
                </button>
                <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}